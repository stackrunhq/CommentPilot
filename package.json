{
  "name": "commentpilot",
  "version": "0.6.0",
  "description": "CommentPilot 多模型评论回复工作台",
  "author": "CommentPilot",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "start": "node src/app/server.js",
    "restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev/restart-backend.ps1",
    "desktop": "electron .",
    "stage": "node scripts/release/stage.mjs",
    "dist": "npm run stage && electron-builder --config config/electron-builder.yml --win --x64",
    "test": "node --test tests/unit/*.test.js",
    "test:ui": "node tests/integration/workbench.mjs",
    "test:integration": "node tests/integration/workbench.mjs",
    "test:projects": "node tests/integration/projects.mjs",
    "test:browser": "node tests/integration/browser.mjs",
    "test:media": "node tests/integration/media-ui.mjs",
    "test:official": "node tests/integration/official-ui.mjs",
    "test:official-flow": "node tests/integration/official-flow.mjs",
    "test:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verification/desktop.ps1",
    "test:diagnostics": "node tests/integration/diagnostics.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
